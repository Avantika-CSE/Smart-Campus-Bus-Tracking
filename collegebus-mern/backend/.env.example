# ============================================================
# CollegeBus Tracking System - Backend Environment Configuration
# ============================================================
# Copy this file to ".env" in this same folder (backend/.env) and
# fill in the values below. Never commit the real ".env" file.

# ---- MongoDB ----
# PASTE YOUR MONGODB CONNECTION URL HERE.
# Example (MongoDB Atlas):
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/collegebus?retryWrites=true&w=majority
# Example (local MongoDB):
#   MONGODB_URI=mongodb://127.0.0.1:27017/collegebus
MONGODB_URI=

# ---- Server ----
PORT=5050

# ---- Auth ----
# Any long random string. Used to sign login tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# The origin the frontend is served from. This backend also serves the
# frontend itself on the PORT above, so the default below is fine for
# local use. Only change this if you host the frontend separately.
CLIENT_ORIGIN=http://localhost:5050

# ---- Admin registration secret ----
# Anyone who wants to register a NEW admin must type this code.
# Choose your own long secret and share it only with people you want as admins.
# Existing admins sign in normally and do not need it.
ADMIN_SECRET_CODE=change-this-secret-admin-code

# ---- Email: Brevo (sends the student sign-in OTP) ----
# BREVO_API_KEY: Brevo -> your name (top right) -> SMTP & API -> API Keys -> Generate a new API key
# BREVO_SENDER_EMAIL: an address you VERIFIED in Brevo (Senders, Domains & Dedicated IPs -> Senders)
# Keep these only here in backend/.env. Never put them in frontend files or on GitHub.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=College Bus Management

# ---- Student e-mail OTP sign-in (optional tuning, defaults shown) ----
# OTP_TTL_MINUTES=5                    how long an OTP is valid
# OTP_MAX_ATTEMPTS=5                   wrong guesses before the OTP is thrown away
# OTP_RESEND_COOLDOWN_SECONDS=60       wait before another OTP can be requested
# OTP_MAX_PER_HOUR=5                   OTP e-mails per e-mail address per hour
# OTP_MAX_PER_HOUR_PER_IP=20           OTP e-mails per visitor (IP) per hour
# OTP_VERIFY_PER_15_MIN=10             OTP checks per e-mail address per 15 minutes
# OTP_VERIFY_PER_15_MIN_PER_IP=40      OTP checks per visitor (IP) per 15 minutes

# ---- When deployed behind a proxy (Render, etc.) ----
# TRUST_PROXY=1
